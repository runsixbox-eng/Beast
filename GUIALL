--========================================================--
-- FUNCTION RUNNER
--========================================================--

local function RunFunction(FileName)

    Status.Text = "Loading " .. FileName .. "..."

    local Success, Result = pcall(function()

        local URL = RAW_BASE .. FileName

        local Source = game:HttpGet(URL)

        local Function = loadstring(Source)

        if not Function then
            error("loadstring failed")
        end

        return Function()

    end)

    if Success then
        Status.Text = "Running: " .. FileName
        Status.TextColor3 = GoldLight

        print("[Dexcode] Loaded:", FileName)
    else
        Status.Text = "Error: " .. FileName
        Status.TextColor3 = Color3.fromRGB(255,100,100)

        warn("[Dexcode]", FileName, Result)
    end
end

