    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1,-33,1,0)
    Label.Position = UDim2.fromOffset(30,0)
    Label.BackgroundTransparency = 1

    -- เอา .lua ออกตอนแสดงผล
    Label.Text = FileName:gsub("%.lua$","")

    Label.TextColor3 = GoldLight
    Label.TextSize = 11
    Label.Font = Enum.Font.GothamBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.TextTruncate = Enum.TextTruncate.AtEnd
    Label.Parent = Button

    -- กดครั้งเดียว = Run
    Button.MouseButton1Click:Connect(function()

        TweenService:Create(
            Button,
            TweenInfo.new(.12),
            {
                BackgroundColor3 = Gold
            }
        ):Play()

        TweenService:Create(
            Label,
            TweenInfo.new(.12),
            {
                TextColor3 = BgBlack
            }
        ):Play()

        task.spawn(function()
            RunFunction(FileName)
        end)

        task.delay(.15,function()

            TweenService:Create(
                Button,
                TweenInfo.new(.15),
                {
                    BackgroundColor3 =
                        Color3.fromRGB(30,28,20)
                }
            ):Play()

            TweenService:Create(
                Label,
                TweenInfo.new(.15),
                {
                    TextColor3 = GoldLight
                }
            ):Play()

        end)

    end)

    return Button
end

--========================================================--
-- AUTO READ GITHUB FOLDER
--========================================================--

local function LoadFunctionList()

    Status.Text = "Reading GitHub..."

    local Success, Data = pcall(function()

        return game:HttpGet(GITHUB_API)

    end)

    if not Success then

        Status.Text = "Failed to read GitHub"
        Status.TextColor3 =
            Color3.fromRGB(255,100,100)

        warn("[Dexcode] GitHub API Error:",Data)

        return
    end

    local Files

    local DecodeSuccess, DecodeResult = pcall(function()

        return HttpService:JSONDecode(Data)

    end)

    if not DecodeSuccess then

        Status.Text = "Invalid GitHub response"

        warn("[Dexcode] JSON Error:",DecodeResult)

        return
    end

    Files = DecodeResult

    local Count = 0

    for _, File in ipairs(Files) do

        if File.type == "file"
        and File.name:lower():sub(-4) == ".lua" then

            CreateFunctionButton(File.name)

            Count += 1

        end

    end

    Status.Text =
        "Loaded " .. Count .. " function(s)"

    Status.TextColor3 = GoldLight

    print("[Dexcode] Functions:",Count)

end

task.spawn(LoadFunctionList)

